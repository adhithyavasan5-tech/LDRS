# ─── Server Environment Variables ─────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── CORS Client URLs (Single URL or comma-separated list for multi-domain) ──
CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com
SERVER_URL=https://api.yourdomain.com

# ─── MongoDB Connection ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT Authentication Secrets ───────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d

# ─── Cloudinary Configuration ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Firebase Cloud Messaging (Web Push Notifications) ────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── AWS S3 / S3-Compatible Storage (Backblaze B2 / Cloudflare R2 / AWS) ───
AWS_REGION=us-west-004
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=ldrs-temporary-movies
# For Backblaze B2 or Cloudflare R2 custom S3-compatible endpoints:
# AWS_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# ─── Client Environment Variables (Frontend Vite Build / Runtime) ────────────
# Set these when building the frontend client bundle for production if hosted separately
VITE_API_URL=/api
VITE_SOCKET_URL=/
